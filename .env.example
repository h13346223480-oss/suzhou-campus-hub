FLASK_APP=run.py
APP_ENV=development
FLASK_DEBUG=1
SECRET_KEY=请替换为随机长字符串
DATABASE_URL=sqlite:///campus_hub.db
APP_BASE_URL=http://127.0.0.1:5000
FEATURE_SURVEYS_PUBLIC=True
FEATURE_TUTORING_PUBLIC=False
TRUST_PROXY=False
# AI 助手（DeepSeek）。未配置 DEEPSEEK_API_KEY 时，AI 助手接口返回“暂未开放”。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 价格单位：元/百万 tokens，默认使用 deepseek-v4-flash 官方平时价
DEEPSEEK_INPUT_PRICE_PER_1M=1
DEEPSEEK_INPUT_CACHE_HIT_PRICE_PER_1M=0.02
DEEPSEEK_OUTPUT_PRICE_PER_1M=2
