# 仅作变量清单。复制到部署平台的密钥管理中，不要提交真实值。
APP_ENV=production
FLASK_APP=wsgi.py
SECRET_KEY=替换为至少32字符的随机密钥
DATABASE_URL=postgresql://campus_hub:强密码@127.0.0.1:5432/campus_hub
APP_BASE_URL=https://campus.example.com
TRUST_PROXY=True
FEATURE_SURVEYS_PUBLIC=True
FEATURE_TUTORING_PUBLIC=False
UPLOAD_FOLDER=/srv/campus-hub/app/static/uploads
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO
LOG_REQUESTS=True

# 首次迁移后由 flask bootstrap-admin 读取；真实值只存云平台密钥管理。
ADMIN_EMAIL=admin@example.com
ADMIN_NICKNAME=平台管理员
ADMIN_PASSWORD=替换为至少12字符的强密码

# 3 个 Web worker × 每 worker 最多 15 个连接，部署前确认数据库连接上限。
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_TIMEOUT=30
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_TIMEOUT=30
